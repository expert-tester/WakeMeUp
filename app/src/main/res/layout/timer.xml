<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#000000"
    android:backgroundTint="@color/black"
    android:gravity="center">

    <LinearLayout
        android:id="@+id/textContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hour"
            android:scaleX="1.5"
            android:scaleY="1.5"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:layout_marginEnd="32dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Minute"
            android:scaleX="1.5"
            android:scaleY="1.5"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:layout_marginEnd="32dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Second"
            android:scaleX="1.5"
            android:scaleY="1.5"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/pickerContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:gravity="center"
        android:orientation="horizontal">

        <NumberPicker
            android:id="@+id/pickerHour"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scaleX="1.5"
            android:scaleY="1.5"
            android:layout_marginEnd="8dp"
            android:theme="@style/Animation.AppCompat.Dialog.NumberPicker" />

        <NumberPicker
            android:id="@+id/pickerMin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scaleX="1.5"
            android:scaleY="1.5"
            android:layout_marginEnd="8dp"
            android:theme="@style/Animation.AppCompat.Dialog.NumberPicker" />

        <NumberPicker
            android:id="@+id/pickerSec"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scaleX="1.5"
            android:scaleY="1.5"
            android:layout_marginEnd="8dp"
            android:theme="@style/Animation.AppCompat.Dialog.NumberPicker" />
    </LinearLayout>

    <TextView
        android:id="@+id/timerText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="00:00:00"
        android:textColor="#FFFFFF"
        android:textSize="40sp"
        android:layout_marginBottom="16dp" />

    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_height="wrap_content"
        android:layout_width="wrap_content"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/resetButton"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:background="@drawable/circle_button_gray"
            android:backgroundTint="@null"
            android:textAllCaps="false"
            android:text="Reset"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/startButton"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/circle_button_green"
            android:backgroundTint="@null"
            android:textAllCaps="false"
            android:text="Start"
            android:textColor="#5fab72"
            android:textSize="15sp"
            android:layout_marginLeft="100dp"/>
    </LinearLayout>
</LinearLayout>
